# Copie este arquivo para ".env" (na mesma pasta) e ajuste.

# ---------------------------------------------------------------
# FONTE DOS DADOS
#   sim = simulador interno (não precisa de CLP)
#   plc = CLP S7-1200 real na bancada
# ---------------------------------------------------------------
MODE=sim

# ---------------------------------------------------------------
# >>> COLOQUE AQUI O IP DO CLP <<<
# (TIA Portal > Dispositivo > Interface PROFINET > Endereços Ethernet)
# O PC precisa estar na mesma sub-rede (ex.: CLP 192.168.0.1, PC 192.168.0.10)
# ---------------------------------------------------------------
PLC_IP=192.168.0.1
PLC_RACK=0
PLC_SLOT=1

# >>> NÚMERO DO DB DE SUPERVISÃO NO CLP <<<
# (Propriedades do DB_Supervisorio > Geral > Número)
PLC_DB=10

# Intervalo de leitura do CLP (ms)
PLC_POLL_MS=200

# Porta do servidor WebSocket (o frontend usa via proxy do Vite)
PORT=8080

# Log em CSV na pasta backend/logs (true/false)
LOG_CSV=true
